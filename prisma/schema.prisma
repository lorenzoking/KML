generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  COMMISSIONER
  USER
}

enum GameType {
  REGULAR_SEASON
  PLAYOFF
  SUPER_BOWL
  PRESEASON
  SIMULATED
  OTHER
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  VOIDED
}

enum SeasonStatus {
  ACTIVE
  ARCHIVED
}

enum IdentityType {
  TEAM
  COACH
}

enum IdentityStatus {
  AVAILABLE
  RESTRICTED
  LEGACY
}

enum HotSeatStatus {
  SECURE
  STABLE
  WATCH
  PRESSURED
  HOT_SEAT
  FIRING_ELIGIBLE
}

enum ReputationCategory {
  GENERAL
  CONDUCT
  EXPECTATION
  GAME_MANAGEMENT
  ROSTER
  TANKING
  TRADE
  DRAFT
  OWNERSHIP_REVIEW
  CAROUSEL
  BONUS
  PENALTY
  SIM_SCORE
}

enum CarouselMoveType {
  RE_SIGN
  EXTEND
  CHANGE_TEAM
  VOLUNTARY_BUYOUT
  VACANCY_APPLICATION
  REASSIGNMENT
}

enum CarouselApplicationStatus {
  PENDING
  APPROVED
  DENIED
  WITHDRAWN
}

enum PlayoffResult {
  NONE
  WILD_CARD
  DIVISIONAL
  CONFERENCE
  SUPER_BOWL
  CHAMPION
}

enum ExpectationResult {
  PENDING
  MISSED
  MET
  EXCEEDED
}

enum StoryCategory {
  FEATURE
  GAME_OF_WEEK
  PLAYER_OF_WEEK
  COACHING
  DRAFT
  LEAGUE
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  name                 String?
  image                String?
  role                 Role      @default(USER)
  isActive             Boolean   @default(true)
  adminNotes           String?
  requestedFranchiseId String?
  teamRequestNote      String?
  teamRequestedAt      DateTime?
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  memberships           LeagueMembership[]
  submissions           GameSubmission[]       @relation("SubmissionSubmitter")
  reviewedSubmissions   GameSubmission[]       @relation("SubmissionReviewer")
  xpAdjustmentsReceived XPAdjustment[]         @relation("XPTarget")
  xpAdjustmentsCreated  XPAdjustment[]         @relation("XPCreator")
  reputationReceived    ReputationAdjustment[] @relation("RepTarget")
  reputationCreated     ReputationAdjustment[] @relation("RepCreator")
  voidedResults         GameResult[]           @relation("ResultVoidedBy")
  coachProfile          CoachProfile?
  seasonReviews         CoachSeasonReview[]
  carouselApplications  CarouselApplication[]  @relation("CarouselApplicant")
  carouselDecisions     CarouselApplication[]  @relation("CarouselReviewer")
  waitlistEntries       WaitlistEntry[]
  storiesAuthored       LeagueStory[]          @relation("StoryAuthor")
  storyPollOptions      StoryPollOption[]      @relation("StoryPollOptionCoach")
  storyPollVotes        StoryPollVote[]        @relation("StoryPollVoteUser")
  storyReactions        StoryReaction[]        @relation("StoryReactionUser")
  storyComments         StoryComment[]         @relation("StoryCommentUser")
  auditLogs             AuditLog[]
  contractSigningsSubmitted PlayerContractSigning[] @relation("ContractSigningSubmitter")
  requestedFranchise    Franchise?             @relation("UserRequestedFranchise", fields: [requestedFranchiseId], references: [id], onDelete: SetNull)

  @@index([requestedFranchiseId])
}

model Franchise {
  id                       String  @id @default(cuid())
  name                     String  @unique
  abbreviation             String  @unique
  city                     String
  conference               String
  division                 String
  primaryColor             String  @default("#1a1a1a")
  sortOrder                Int     @default(0)
  teamIdentityId           String?
  teamIdentityChosenSeason Int?

  memberships                   LeagueMembership[]
  submissionsAsUser             GameSubmission[]      @relation("UserTeam")
  submissionsAsOpp              GameSubmission[]      @relation("OpponentTeam")
  resultsAsHome                 GameResult[]          @relation("ResultHome")
  resultsAsAway                 GameResult[]          @relation("ResultAway")
  resultsAsWinner               GameResult[]          @relation("ResultWinner")
  xpAdjustments                 XPAdjustment[]
  teamIdentity                  IdentityCatalog?      @relation("FranchiseTeamIdentity", fields: [teamIdentityId], references: [id])
  carouselVacancies             CarouselVacancy[]
  carouselCurrentApplications   CarouselApplication[] @relation("CarouselCurrentTeam")
  carouselRequestedApplications CarouselApplication[] @relation("CarouselRequestedTeam")
  teamRequests                  User[]                @relation("UserRequestedFranchise")
  storyPollOptions              StoryPollOption[]
  scheduledHome                 ScheduledGame[]       @relation("ScheduledHome")
  scheduledAway                 ScheduledGame[]       @relation("ScheduledAway")
  contractSignings              PlayerContractSigning[]
}

model Season {
  id         String       @id @default(cuid())
  number     Int          @unique
  name       String
  isActive   Boolean      @default(false)
  status     SeasonStatus @default(ACTIVE)
  archivedAt DateTime?
  createdAt  DateTime     @default(now())

  memberships           LeagueMembership[]
  submissions           GameSubmission[]
  results               GameResult[]
  xpAdjustments         XPAdjustment[]
  reputationAdjustments ReputationAdjustment[]
  coachSeasonReviews    CoachSeasonReview[]
  carouselVacancies     CarouselVacancy[]
  carouselApplications  CarouselApplication[]
  stories               LeagueStory[]
  scheduledGames        ScheduledGame[]
  contractSignings      PlayerContractSigning[]
}

model ScheduledGame {
  id          String   @id @default(cuid())
  seasonId    String
  week        Int
  homeTeamId  String
  awayTeamId  String
  isPrimetime Boolean  @default(false)
  createdAt   DateTime @default(now())

  season   Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  homeTeam Franchise @relation("ScheduledHome", fields: [homeTeamId], references: [id])
  awayTeam Franchise @relation("ScheduledAway", fields: [awayTeamId], references: [id])

  @@unique([seasonId, week, homeTeamId])
  @@unique([seasonId, week, awayTeamId])
  @@index([seasonId, week])
  @@index([homeTeamId])
  @@index([awayTeamId])
}

model LeagueMembership {
  id          String    @id @default(cuid())
  userId      String
  franchiseId String
  seasonId    String
  isActive    Boolean   @default(true)
  startedWeek Int       @default(1)
  endedWeek   Int?
  endedAt     DateTime?
  assignedAt  DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  franchise Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  season    Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  // Multiple stints per user/season are allowed (fired → rehired elsewhere).
  // Only one ACTIVE stint per user/season and per franchise/season is enforced in app code.
  @@index([userId, seasonId])
  @@index([franchiseId, seasonId])
  @@index([userId])
  @@index([franchiseId])
  @@index([isActive])
}

model LeagueSetting {
  id                 String   @id @default(cuid())
  key                String   @unique @default("default")
  leagueName         String   @default("Kings Madden League")
  currentSeason      Int      @default(1)
  currentWeek        Int      @default(1)
  xpGamePlayed       Int      @default(1)
  xpWinBonus         Int      @default(4)
  startingRepScore   Int      @default(85)
  startingGmRepScore Int      @default(75)
  hotSeatThreshold   Int      @default(59)
  firingThreshold    Int      @default(44)
  watchThreshold     Int      @default(70)
  carouselMinCoachRep Int     @default(75)
  buyoutMinCoachRep  Int      @default(85)
  buyoutXpCost       Int      @default(25)
  startingContractYears Int   @default(3)
  carouselOpen       Boolean  @default(false)
  rulesMarkdown      String   @default("")
  updatedAt          DateTime @updatedAt
}

model GameSubmission {
  id             String           @id @default(cuid())
  seasonId       String
  week           Int
  gameType       GameType         @default(REGULAR_SEASON)
  submitterId    String
  userTeamId     String
  opponentTeamId String
  /// Null on a force win until the CPU sim score is posted after the week advances.
  userScore      Int?
  opponentScore  Int?
  /// Madden/KML realism rating for the opponent's play (1–5), reported by the submitter. Scores ≤2 feed Bad Sim rules for that opponent. Null on force wins — nobody played.
  opponentSimScore Int?
  /// Submitter was available and received a force win because the opponent could not play.
  isForceWin     Boolean          @default(false)
  /// Sim Score the opponent coach gave the submitting team (1–5). Null until that coach submits.
  userTeamSimScore Int?
  notes          String?
  /// Official KML Primetime window (desk slate or submitter-marked).
  isPrimetime    Boolean          @default(false)
  /// Commissioner filed this result for the coaches. Still counts for standings
  /// and Coaching Reputation, but does not award coach XP.
  skipXp               Boolean @default(false)
  filedByCommissioner  Boolean @default(false)
  status         SubmissionStatus @default(PENDING)
  reviewedById   String?
  reviewedAt     DateTime?
  decisionNote   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  season       Season      @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  submitter    User        @relation("SubmissionSubmitter", fields: [submitterId], references: [id], onDelete: Cascade)
  userTeam     Franchise   @relation("UserTeam", fields: [userTeamId], references: [id])
  opponentTeam Franchise   @relation("OpponentTeam", fields: [opponentTeamId], references: [id])
  reviewedBy   User?       @relation("SubmissionReviewer", fields: [reviewedById], references: [id])
  result       GameResult?

  @@index([status])
  @@index([seasonId, week])
  @@index([submitterId])
  @@index([userTeamId, opponentTeamId, seasonId, week])
}

model GameResult {
  id           String    @id @default(cuid())
  submissionId String    @unique
  seasonId     String
  week         Int
  gameType     GameType
  homeTeamId   String
  awayTeamId   String
  homeScore    Int
  awayScore    Int
  /// Opponent Sim Score from the approved submission (away team = opponent when submitter is home).
  opponentSimScore Int?
  /// Sim Score the away/opponent coach gave the home/submitting team.
  userTeamSimScore Int?
  winnerTeamId String?
  isForceWin   Boolean   @default(false)
  isPrimetime  Boolean   @default(false)
  isVoided     Boolean   @default(false)
  voidedAt     DateTime?
  voidedById   String?
  voidReason   String?
  createdAt    DateTime  @default(now())

  submission GameSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  season     Season         @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  homeTeam   Franchise      @relation("ResultHome", fields: [homeTeamId], references: [id])
  awayTeam   Franchise      @relation("ResultAway", fields: [awayTeamId], references: [id])
  winnerTeam Franchise?     @relation("ResultWinner", fields: [winnerTeamId], references: [id])
  voidedBy   User?          @relation("ResultVoidedBy", fields: [voidedById], references: [id])

  @@index([seasonId])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([isVoided])
}

model XPAdjustment {
  id           String   @id @default(cuid())
  userId       String
  franchiseId  String?
  seasonId     String?
  amount       Int
  reason       String
  isAutomatic  Boolean  @default(false)
  submissionId String?
  createdById  String?
  createdAt    DateTime @default(now())

  user      User       @relation("XPTarget", fields: [userId], references: [id], onDelete: Cascade)
  franchise Franchise? @relation(fields: [franchiseId], references: [id])
  season    Season?    @relation(fields: [seasonId], references: [id])
  createdBy User?      @relation("XPCreator", fields: [createdById], references: [id])

  @@index([userId])
  @@index([seasonId])
}

model ReputationAdjustment {
  id           String             @id @default(cuid())
  userId       String
  amount       Int
  gmAmount     Int                @default(0)
  category     ReputationCategory @default(GENERAL)
  seasonId     String?
  week         Int?
  reason       String
  evidenceUrl  String?
  isAutomatic  Boolean            @default(false)
  submissionId String?
  ruleKey      String?
  createdById  String?
  createdAt    DateTime           @default(now())

  user      User    @relation("RepTarget", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("RepCreator", fields: [createdById], references: [id])
  season    Season? @relation(fields: [seasonId], references: [id])

  @@index([userId])
  @@index([seasonId])
  @@index([category])
  @@index([createdAt])
  @@index([submissionId])
  @@index([userId, seasonId, ruleKey])
}

model IdentityCatalog {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  type        IdentityType
  coreBenefit String
  restriction String
  changeRule  String
  xpCost      Int            @default(0)
  level       String
  minRepScore Int            @default(0)
  status      IdentityStatus @default(AVAILABLE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  coachProfiles      CoachProfile[] @relation("CoachIdentity")
  assignedFranchises Franchise[]    @relation("FranchiseTeamIdentity")

  @@index([type])
  @@index([status])
}

model CoachProfile {
  id                    String         @id @default(cuid())
  userId                String         @unique
  discordName           String?
  avatarUrl             String?
  bio                   String?
  motto                 String?
  hometown              String?
  favoriteScheme        String?
  selectionPick              Int?
  coachIdentityId            String?
  coachIdentityChosenSeason  Int?
  expectationScore           Int            @default(0)
  contractYearsLeft     Int            @default(3)
  tankingStrikes        Int            @default(0)
  gmStrikes             Int            @default(0)
  isAutopilot           Boolean        @default(false)
  autopilotSeason       Int?
  hotSeatStatusOverride HotSeatStatus?
  hotSeatNote           String?
  lastReviewAt          DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  coachIdentity IdentityCatalog? @relation("CoachIdentity", fields: [coachIdentityId], references: [id])

  @@index([coachIdentityId])
}

model WaitlistEntry {
  id          String   @id @default(cuid())
  userId       String
  position     Int
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([position])
  @@index([isActive])
  @@index([userId])
}

model CoachSeasonReview {
  id                String            @id @default(cuid())
  userId            String
  seasonId          String
  playoffResult     PlayoffResult     @default(NONE)
  expectationResult ExpectationResult @default(PENDING)
  reviewNotes       String?
  reviewedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([userId, seasonId])
  @@index([seasonId])
}

model CarouselVacancy {
  id          String   @id @default(cuid())
  seasonId    String
  franchiseId String
  reason      String
  isOpen      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  season       Season                @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  franchise    Franchise             @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  applications CarouselApplication[]

  @@index([seasonId])
  @@index([isOpen])
}

model CarouselApplication {
  id              String                    @id @default(cuid())
  seasonId        String
  applicantId     String
  currentTeamId   String?
  vacancyId       String?
  requestedTeamId String?
  moveType        CarouselMoveType
  buyoutEligible  Boolean                   @default(false)
  xpCost          Int                       @default(0)
  priorityScore   Float                     @default(0)
  status          CarouselApplicationStatus @default(PENDING)
  decisionNote    String?
  assignedTeamId  String?
  contractYears   Int?
  reviewedById    String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  season        Season           @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  applicant     User             @relation("CarouselApplicant", fields: [applicantId], references: [id], onDelete: Cascade)
  currentTeam   Franchise?       @relation("CarouselCurrentTeam", fields: [currentTeamId], references: [id])
  requestedTeam Franchise?       @relation("CarouselRequestedTeam", fields: [requestedTeamId], references: [id])
  vacancy       CarouselVacancy? @relation(fields: [vacancyId], references: [id], onDelete: SetNull)
  reviewedBy    User?            @relation("CarouselReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([seasonId])
  @@index([status])
  @@index([applicantId])
}

model LeagueStory {
  id          String        @id @default(cuid())
  slug        String        @unique
  seasonId    String?
  week        Int?
  category    StoryCategory @default(LEAGUE)
  title       String
  eyebrow     String?
  summary     String
  body        String
  isFeatured  Boolean       @default(false)
  isPublished Boolean       @default(true)
  sortOrder   Int           @default(0)
  authorId    String?
  publishedAt DateTime      @default(now())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  season    Season?         @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  author    User?           @relation("StoryAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  polls     StoryPoll[]
  reactions StoryReaction[]
  comments  StoryComment[]

  @@index([isPublished, isFeatured])
  @@index([category])
  @@index([seasonId, week])
  @@index([sortOrder])
}

model StoryPoll {
  id        String   @id @default(cuid())
  storyId   String
  key       String
  title     String
  isOpen    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  story     LeagueStory         @relation(fields: [storyId], references: [id], onDelete: Cascade)
  questions StoryPollQuestion[]

  @@unique([storyId, key])
  @@index([storyId])
}

model StoryPollQuestion {
  id        String @id @default(cuid())
  pollId    String
  prompt    String
  sortOrder Int    @default(0)
  /// Desk-called winner when coaches have not submitted an approved score yet.
  /// An approved GameResult for this matchup always takes precedence.
  declaredWinnerOptionId String?

  poll                 StoryPoll         @relation(fields: [pollId], references: [id], onDelete: Cascade)
  options              StoryPollOption[]
  votes                StoryPollVote[]
  declaredWinnerOption StoryPollOption?  @relation("QuestionDeclaredWinner", fields: [declaredWinnerOptionId], references: [id], onDelete: SetNull)

  @@index([pollId])
  @@index([declaredWinnerOptionId])
}

model StoryPollOption {
  id            String  @id @default(cuid())
  questionId    String
  label         String
  franchiseAbbr String?
  franchiseId   String?
  coachUserId   String?
  sortOrder     Int     @default(0)

  question             StoryPollQuestion  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  franchise            Franchise?         @relation(fields: [franchiseId], references: [id], onDelete: SetNull)
  coach                User?              @relation("StoryPollOptionCoach", fields: [coachUserId], references: [id], onDelete: SetNull)
  votes                StoryPollVote[]
  declaredForQuestions StoryPollQuestion[] @relation("QuestionDeclaredWinner")

  @@index([questionId])
  @@index([coachUserId])
  @@index([franchiseId])
}

model StoryPollVote {
  id         String   @id @default(cuid())
  questionId String
  optionId   String
  userId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  question StoryPollQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  option   StoryPollOption   @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user     User              @relation("StoryPollVoteUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([questionId, userId])
  @@index([optionId])
  @@index([userId])
}

model StoryReaction {
  id        String   @id @default(cuid())
  storyId   String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  story LeagueStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User        @relation("StoryReactionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId, emoji])
  @@index([storyId])
}

model StoryComment {
  id        String   @id @default(cuid())
  storyId   String
  userId    String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  story LeagueStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User        @relation("StoryCommentUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([storyId, createdAt])
  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
}

enum ContractPosition {
  QB
  RB
  WR
  TE
  OL
  EDGE
  DL
  LB
  CB
  S
  K
  P
}

enum ContractPlayerTier {
  ELITE
  STARTER
  DEPTH
}

enum ContractPenaltyTier {
  NONE
  MINOR
  MODERATE
  SEVERE
}

enum ContractSigningStatus {
  LOGGED
  APPLIED
  VOIDED
}

enum SeverePenaltyResolution {
  PENDING
  VOID_SIGNING
  /// Keep the player on a short, expensive deal (legacy enum name).
  STEEP_BELOW_MARKET
}

model ContractRuleSetting {
  id                         String                   @id @default(cuid())
  key                        String                   @unique @default("default")
  maxContractLength          Int                      @default(6)
  minContractLength          Int                      @default(2)
  maxTotalSalaryMillions     Float                    @default(200)
  maxSigningBonusMillions    Float                    @default(250)
  longContractYears          Int                      @default(7)
  overpayNoneMax             Float                    @default(1.15)
  overpayMinorMax            Float                    @default(1.50)
  overpayModerateMax         Float                    @default(2.00)
  /// Packed into fewer years. Floor 1.10 in the calculator.
  moderateMarketMultiplier   Float                    @default(1.10)
  /// Packed into min length. Floor 1.15 in the calculator.
  severeMarketMultiplier     Float                    @default(1.25)
  capPenaltyPercentOfOverage Float                    @default(25)
  rookieScaleFallbackRatio   Float                    @default(0.35)
  depthMarketRatio           Float                    @default(0.55)
  defaultSevereResolution    SeverePenaltyResolution  @default(PENDING)
  updatedAt                  DateTime                 @updatedAt
}

/// Spotrac-style positional comps, pasted in by the commissioner (no public API).
model PositionMarketComp {
  id                 String            @id @default(cuid())
  position           ContractPosition  @unique
  marketSetterName   String?
  topOfMarketApy     Float
  starterFloorApy    Float
  typicalBonusRatio  Float
  typicalLengthYears Int
  guaranteePercent   Float?
  sourceNote         String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model PlayerContractSigning {
  id                   String                    @id @default(cuid())
  seasonId             String
  franchiseId          String
  submittedById        String
  playerName           String
  position             ContractPosition
  playerTier           ContractPlayerTier        @default(STARTER)
  yearsRemaining       Int                       @default(0)
  remainingDealApy     Float?
  asSignedLength       Int
  asSignedTotalSalary  Float
  asSignedSigningBonus Float
  asSignedApy          Float
  marketApy            Float
  overpayRatio         Float
  penaltyTier          ContractPenaltyTier
  longContractFlag     Boolean                   @default(false)
  recommendedOption    String
  snapshot             Json
  status               ContractSigningStatus     @default(LOGGED)
  severeResolution     SeverePenaltyResolution   @default(PENDING)
  commissionerNote     String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  season      Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  franchise   Franchise @relation(fields: [franchiseId], references: [id])
  submittedBy User      @relation("ContractSigningSubmitter", fields: [submittedById], references: [id], onDelete: Cascade)

  @@index([seasonId, overpayRatio])
  @@index([seasonId, penaltyTier])
  @@index([franchiseId])
  @@index([createdAt])
  @@index([seasonId, playerName])
}
