generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  COMMISSIONER
  USER
}

enum GameType {
  REGULAR_SEASON
  PLAYOFF
  SUPER_BOWL
  PRESEASON
  SIMULATED
  OTHER
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  VOIDED
}

enum SeasonStatus {
  ACTIVE
  ARCHIVED
}

enum IdentityType {
  TEAM
  COACH
}

enum IdentityStatus {
  AVAILABLE
  RESTRICTED
  LEGACY
}

enum HotSeatStatus {
  SECURE
  STABLE
  WATCH
  PRESSURED
  HOT_SEAT
  FIRING_ELIGIBLE
}

enum ReputationCategory {
  GENERAL
  CONDUCT
  EXPECTATION
  GAME_MANAGEMENT
  ROSTER
  TANKING
  TRADE
  DRAFT
  OWNERSHIP_REVIEW
  CAROUSEL
  BONUS
  PENALTY
}

enum CarouselMoveType {
  RE_SIGN
  EXTEND
  CHANGE_TEAM
  VOLUNTARY_BUYOUT
  VACANCY_APPLICATION
  REASSIGNMENT
}

enum CarouselApplicationStatus {
  PENDING
  APPROVED
  DENIED
  WITHDRAWN
}

enum PlayoffResult {
  NONE
  WILD_CARD
  DIVISIONAL
  CONFERENCE
  SUPER_BOWL
  CHAMPION
}

enum ExpectationResult {
  PENDING
  MISSED
  MET
  EXCEEDED
}

enum StoryCategory {
  FEATURE
  GAME_OF_WEEK
  PLAYER_OF_WEEK
  COACHING
  DRAFT
  LEAGUE
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  name                 String?
  image                String?
  role                 Role      @default(USER)
  isActive             Boolean   @default(true)
  adminNotes           String?
  requestedFranchiseId String?
  teamRequestNote      String?
  teamRequestedAt      DateTime?
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  memberships           LeagueMembership[]
  submissions           GameSubmission[]       @relation("SubmissionSubmitter")
  reviewedSubmissions   GameSubmission[]       @relation("SubmissionReviewer")
  xpAdjustmentsReceived XPAdjustment[]         @relation("XPTarget")
  xpAdjustmentsCreated  XPAdjustment[]         @relation("XPCreator")
  reputationReceived    ReputationAdjustment[] @relation("RepTarget")
  reputationCreated     ReputationAdjustment[] @relation("RepCreator")
  voidedResults         GameResult[]           @relation("ResultVoidedBy")
  coachProfile          CoachProfile?
  seasonReviews         CoachSeasonReview[]
  carouselApplications  CarouselApplication[]  @relation("CarouselApplicant")
  carouselDecisions     CarouselApplication[]  @relation("CarouselReviewer")
  waitlistEntries       WaitlistEntry[]
  storiesAuthored       LeagueStory[]          @relation("StoryAuthor")
  auditLogs             AuditLog[]
  requestedFranchise    Franchise?             @relation("UserRequestedFranchise", fields: [requestedFranchiseId], references: [id], onDelete: SetNull)

  @@index([requestedFranchiseId])
}

model Franchise {
  id             String  @id @default(cuid())
  name           String  @unique
  abbreviation   String  @unique
  city           String
  conference     String
  division       String
  primaryColor   String  @default("#1a1a1a")
  sortOrder      Int     @default(0)
  teamIdentityId String?

  memberships                   LeagueMembership[]
  submissionsAsUser             GameSubmission[]      @relation("UserTeam")
  submissionsAsOpp              GameSubmission[]      @relation("OpponentTeam")
  resultsAsHome                 GameResult[]          @relation("ResultHome")
  resultsAsAway                 GameResult[]          @relation("ResultAway")
  resultsAsWinner               GameResult[]          @relation("ResultWinner")
  xpAdjustments                 XPAdjustment[]
  teamIdentity                  IdentityCatalog?      @relation("FranchiseTeamIdentity", fields: [teamIdentityId], references: [id])
  carouselVacancies             CarouselVacancy[]
  carouselCurrentApplications   CarouselApplication[] @relation("CarouselCurrentTeam")
  carouselRequestedApplications CarouselApplication[] @relation("CarouselRequestedTeam")
  teamRequests                  User[]                @relation("UserRequestedFranchise")
}

model Season {
  id         String       @id @default(cuid())
  number     Int          @unique
  name       String
  isActive   Boolean      @default(false)
  status     SeasonStatus @default(ACTIVE)
  archivedAt DateTime?
  createdAt  DateTime     @default(now())

  memberships           LeagueMembership[]
  submissions           GameSubmission[]
  results               GameResult[]
  xpAdjustments         XPAdjustment[]
  reputationAdjustments ReputationAdjustment[]
  coachSeasonReviews    CoachSeasonReview[]
  carouselVacancies     CarouselVacancy[]
  carouselApplications  CarouselApplication[]
  stories               LeagueStory[]
}

model LeagueMembership {
  id          String    @id @default(cuid())
  userId      String
  franchiseId String
  seasonId    String
  isActive    Boolean   @default(true)
  startedWeek Int       @default(1)
  endedWeek   Int?
  endedAt     DateTime?
  assignedAt  DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  franchise Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  season    Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  // Multiple stints per user/season are allowed (fired → rehired elsewhere).
  // Only one ACTIVE stint per user/season and per franchise/season is enforced in app code.
  @@index([userId, seasonId])
  @@index([franchiseId, seasonId])
  @@index([userId])
  @@index([franchiseId])
  @@index([isActive])
}

model LeagueSetting {
  id                 String   @id @default(cuid())
  key                String   @unique @default("default")
  leagueName         String   @default("Kings Madden League")
  currentSeason      Int      @default(1)
  currentWeek        Int      @default(1)
  xpGamePlayed       Int      @default(1)
  xpWinBonus         Int      @default(4)
  startingRepScore   Int      @default(75)
  startingGmRepScore Int      @default(75)
  hotSeatThreshold   Int      @default(59)
  firingThreshold    Int      @default(44)
  watchThreshold     Int      @default(70)
  carouselMinCoachRep Int     @default(75)
  buyoutMinCoachRep  Int      @default(85)
  buyoutXpCost       Int      @default(25)
  startingContractYears Int   @default(3)
  carouselOpen       Boolean  @default(false)
  rulesMarkdown      String   @default("")
  updatedAt          DateTime @updatedAt
}

model GameSubmission {
  id             String           @id @default(cuid())
  seasonId       String
  week           Int
  gameType       GameType         @default(REGULAR_SEASON)
  submitterId    String
  userTeamId     String
  opponentTeamId String
  userScore      Int
  opponentScore  Int
  notes          String?
  status         SubmissionStatus @default(PENDING)
  reviewedById   String?
  reviewedAt     DateTime?
  decisionNote   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  season       Season      @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  submitter    User        @relation("SubmissionSubmitter", fields: [submitterId], references: [id], onDelete: Cascade)
  userTeam     Franchise   @relation("UserTeam", fields: [userTeamId], references: [id])
  opponentTeam Franchise   @relation("OpponentTeam", fields: [opponentTeamId], references: [id])
  reviewedBy   User?       @relation("SubmissionReviewer", fields: [reviewedById], references: [id])
  result       GameResult?

  @@index([status])
  @@index([seasonId, week])
  @@index([submitterId])
  @@index([userTeamId, opponentTeamId, seasonId, week])
}

model GameResult {
  id           String    @id @default(cuid())
  submissionId String    @unique
  seasonId     String
  week         Int
  gameType     GameType
  homeTeamId   String
  awayTeamId   String
  homeScore    Int
  awayScore    Int
  winnerTeamId String?
  isVoided     Boolean   @default(false)
  voidedAt     DateTime?
  voidedById   String?
  voidReason   String?
  createdAt    DateTime  @default(now())

  submission GameSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  season     Season         @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  homeTeam   Franchise      @relation("ResultHome", fields: [homeTeamId], references: [id])
  awayTeam   Franchise      @relation("ResultAway", fields: [awayTeamId], references: [id])
  winnerTeam Franchise?     @relation("ResultWinner", fields: [winnerTeamId], references: [id])
  voidedBy   User?          @relation("ResultVoidedBy", fields: [voidedById], references: [id])

  @@index([seasonId])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([isVoided])
}

model XPAdjustment {
  id           String   @id @default(cuid())
  userId       String
  franchiseId  String?
  seasonId     String?
  amount       Int
  reason       String
  isAutomatic  Boolean  @default(false)
  submissionId String?
  createdById  String?
  createdAt    DateTime @default(now())

  user      User       @relation("XPTarget", fields: [userId], references: [id], onDelete: Cascade)
  franchise Franchise? @relation(fields: [franchiseId], references: [id])
  season    Season?    @relation(fields: [seasonId], references: [id])
  createdBy User?      @relation("XPCreator", fields: [createdById], references: [id])

  @@index([userId])
  @@index([seasonId])
}

model ReputationAdjustment {
  id          String             @id @default(cuid())
  userId      String
  amount      Int
  gmAmount    Int                @default(0)
  category    ReputationCategory @default(GENERAL)
  seasonId    String?
  week        Int?
  reason      String
  evidenceUrl String?
  createdById String?
  createdAt   DateTime           @default(now())

  user      User    @relation("RepTarget", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("RepCreator", fields: [createdById], references: [id])
  season    Season? @relation(fields: [seasonId], references: [id])

  @@index([userId])
  @@index([seasonId])
  @@index([category])
  @@index([createdAt])
}

model IdentityCatalog {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  type        IdentityType
  coreBenefit String
  restriction String
  changeRule  String
  xpCost      Int            @default(0)
  level       String
  minRepScore Int            @default(0)
  status      IdentityStatus @default(AVAILABLE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  coachProfiles      CoachProfile[] @relation("CoachIdentity")
  assignedFranchises Franchise[]    @relation("FranchiseTeamIdentity")

  @@index([type])
  @@index([status])
}

model CoachProfile {
  id                    String         @id @default(cuid())
  userId                String         @unique
  discordName           String?
  selectionPick         Int?
  coachIdentityId       String?
  expectationScore      Int            @default(0)
  contractYearsLeft     Int            @default(3)
  tankingStrikes        Int            @default(0)
  gmStrikes             Int            @default(0)
  isAutopilot           Boolean        @default(false)
  autopilotSeason       Int?
  hotSeatStatusOverride HotSeatStatus?
  hotSeatNote           String?
  lastReviewAt          DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  coachIdentity IdentityCatalog? @relation("CoachIdentity", fields: [coachIdentityId], references: [id])

  @@index([coachIdentityId])
}

model WaitlistEntry {
  id          String   @id @default(cuid())
  userId       String
  position     Int
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([position])
  @@index([isActive])
  @@index([userId])
}

model CoachSeasonReview {
  id                String            @id @default(cuid())
  userId            String
  seasonId          String
  playoffResult     PlayoffResult     @default(NONE)
  expectationResult ExpectationResult @default(PENDING)
  reviewNotes       String?
  reviewedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([userId, seasonId])
  @@index([seasonId])
}

model CarouselVacancy {
  id          String   @id @default(cuid())
  seasonId    String
  franchiseId String
  reason      String
  isOpen      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  season       Season                @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  franchise    Franchise             @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  applications CarouselApplication[]

  @@index([seasonId])
  @@index([isOpen])
}

model CarouselApplication {
  id              String                    @id @default(cuid())
  seasonId        String
  applicantId     String
  currentTeamId   String?
  vacancyId       String?
  requestedTeamId String?
  moveType        CarouselMoveType
  buyoutEligible  Boolean                   @default(false)
  xpCost          Int                       @default(0)
  priorityScore   Float                     @default(0)
  status          CarouselApplicationStatus @default(PENDING)
  decisionNote    String?
  assignedTeamId  String?
  contractYears   Int?
  reviewedById    String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  season        Season           @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  applicant     User             @relation("CarouselApplicant", fields: [applicantId], references: [id], onDelete: Cascade)
  currentTeam   Franchise?       @relation("CarouselCurrentTeam", fields: [currentTeamId], references: [id])
  requestedTeam Franchise?       @relation("CarouselRequestedTeam", fields: [requestedTeamId], references: [id])
  vacancy       CarouselVacancy? @relation(fields: [vacancyId], references: [id], onDelete: SetNull)
  reviewedBy    User?            @relation("CarouselReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([seasonId])
  @@index([status])
  @@index([applicantId])
}

model LeagueStory {
  id          String        @id @default(cuid())
  slug        String        @unique
  seasonId    String?
  week        Int?
  category    StoryCategory @default(LEAGUE)
  title       String
  eyebrow     String?
  summary     String
  body        String
  isFeatured  Boolean       @default(false)
  isPublished Boolean       @default(true)
  sortOrder   Int           @default(0)
  authorId    String?
  publishedAt DateTime      @default(now())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  season Season? @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  author User?   @relation("StoryAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([isPublished, isFeatured])
  @@index([category])
  @@index([seasonId, week])
  @@index([sortOrder])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
}
