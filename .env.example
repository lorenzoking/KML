# Database
# Local Docker:
# DATABASE_URL="postgresql://kml:kml@localhost:5432/kings_madden_league"
# DIRECT_URL="postgresql://kml:kml@localhost:5432/kings_madden_league"
#
# Supabase (REQUIRED for Vercel):
# Open Supabase → Connect → ORMs → Prisma
# Prisma 7: app queries use DATABASE_URL (pooler). CLI migrations use DIRECT_URL.
# - DATABASE_URL = Transaction pooler (port 6543), user looks like postgres.<project-ref>
#   Append: ?pgbouncer=true&connection_limit=1
# - DIRECT_URL   = Direct connection (db.<project-ref>.supabase.co:5432) for migrations
#
# Important: Vercel cannot use the direct db.*.supabase.co host alone (IPv6).
# Always set DATABASE_URL to the pooler URI in Vercel.
DATABASE_URL="postgresql://kml:kml@localhost:5432/kings_madden_league"
DIRECT_URL="postgresql://kml:kml@localhost:5432/kings_madden_league"

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Recommended: each commissioner's personal Gmail, comma-separated.
# They sign in with Google, get COMMISSIONER role, and can also be assigned a team.
COMMISSIONER_EMAILS="you@gmail.com,co-commissioner@gmail.com"

# Optional shared backup login (emergencies only). Prefer personal Google accounts.
# If both are set, a password form appears on /sign-in.
COMMISSIONER_BACKUP_EMAIL="commissioners@yourleague.com"
COMMISSIONER_BACKUP_PASSWORD="choose-a-long-shared-password"
COMMISSIONER_BACKUP_NAME="League Commissioners"

# Local-only demo login (bypasses Google OAuth). Never enable in production.
AUTH_DEV_BYPASS="true"

# Required to run `npm run db:seed` because seed wipes app User rows.
# Never set this in production unless you intentionally want a full demo reset.
# (Supabase Auth accounts are NOT deleted by seed — only the app User table.)
ALLOW_DB_RESET="true"
