# Database
# Local Docker:
# DATABASE_URL="postgresql://kml:kml@localhost:5432/kings_madden_league"
# DIRECT_URL="postgresql://kml:kml@localhost:5432/kings_madden_league"
#
# Supabase (Vercel / production):
# - DATABASE_URL = Transaction pooler URI (port 6543), add ?pgbouncer=true
# - DIRECT_URL   = Direct URI (port 5432) for migrations
# Supabase → Project Settings → Database → Connection string
DATABASE_URL="postgresql://kml:kml@localhost:5432/kings_madden_league"
DIRECT_URL="postgresql://kml:kml@localhost:5432/kings_madden_league"

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Comma-separated emails promoted to COMMISSIONER on first sign-in
COMMISSIONER_EMAILS="commissioner@example.com"

# Local-only demo login (bypasses Google OAuth). Never enable in production.
AUTH_DEV_BYPASS="true"
